<Window x:Class="EnterprisePOS.UI.Dialogs.ShiftOpeningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shift Opening Float" Height="420" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0F172A">
    <Border Margin="24" Background="#1E293B" CornerRadius="12" Padding="24" BorderBrush="#334155" BorderThickness="1">
        <StackPanel VerticalAlignment="Center">
            <!-- Header -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                <Border Width="48" Height="48" CornerRadius="24" Background="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="💵" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="CASH DRAWER SHIFT OPENING" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Specify starting cash float before taking billing orders" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Cashier & Terminal Details -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Cashier Name" Foreground="#94A3B8" FontSize="11"/>
                    <TextBlock x:Name="TxtCashierName" Text="Head Cashier" Foreground="#38BDF8" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Terminal Name" Foreground="#94A3B8" FontSize="11"/>
                    <TextBlock x:Name="TxtTerminalName" Text="POS-MAIN-01" Foreground="#38BDF8" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
            </Grid>

            <!-- Opening Cash Input -->
            <TextBlock Text="Opening Cash Amount (LKR)" Foreground="#F8FAFC" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtOpeningCash" Text="5000" FontSize="20" FontWeight="Bold" Padding="10" Background="#0F172A" Foreground="#22C55E" BorderBrush="#22C55E" Margin="0,0,0,20" TextAlignment="Right"/>

            <!-- Buttons -->
            <Button Content="🚀 Start Shift" Click="BtnStartShift_Click" Background="#22C55E" Foreground="#0F172A" FontSize="16" Height="45" FontWeight="Bold"/>
        </StackPanel>
    </Border>
</Window>
