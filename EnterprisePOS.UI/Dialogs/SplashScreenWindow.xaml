<Window x:Class="EnterprisePOS.UI.Dialogs.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enterprise POS Startup" Height="360" Width="580"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Background="#121826" CornerRadius="16" BorderBrush="#1F293D" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.6" Direction="270" ShadowDepth="8"/>
        </Border.Effect>
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Brand Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Border Width="64" Height="64" CornerRadius="32" Background="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="🏨" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="ABC HOTEL &amp; RESTAURANT" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                <TextBlock Text="Enterprise POS &amp; Hotel Management System" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <Border Background="#0EA5E9" Padding="8,2" CornerRadius="10" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock Text="v1.0.0 Enterprise Edition" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                </Border>
            </StackPanel>

            <!-- Status Animation -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="20,0">
                <TextBlock x:Name="TxtStatus" Text="Initializing Database Connection..." Foreground="#CBD5E1" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <ProgressBar x:Name="LoadingProgress" Height="8" Minimum="0" Maximum="100" Value="10" Background="#1E293B" Foreground="#0EA5E9" BorderThickness="0"/>
            </StackPanel>

            <!-- Footer -->
            <TextBlock Grid.Row="2" Text="Powered by Enterprise POS Architecture • SQLite/EF Core Engine" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </Grid>
    </Border>
</Window>
