<Window x:Class="EnterprisePOS.UI.Dialogs.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thermal Receipt Preview - 80mm Printer" Height="680" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0F172A">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Simulated 80mm Thermal Receipt -->
        <Border Grid.Row="0" Background="White" CornerRadius="4" Padding="20" Margin="0,0,0,15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ReceiptPanel" TextElement.Foreground="Black" TextElement.FontFamily="Consolas">
                    <!-- Header -->
                    <TextBlock Text="GRAND HOTEL &amp; RESTAURANT" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                    <TextBlock Text="No. 45, Beach Road, Sri Lanka" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    <TextBlock Text="Tel: +94 77 123 4567" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock Text="----------------------------------------" HorizontalAlignment="Center" Margin="0,3"/>
                    <TextBlock x:Name="TxtBillBanner" Text="*** FINAL PAID INVOICE ***" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,2"/>
                    <TextBlock Text="----------------------------------------" HorizontalAlignment="Center" Margin="0,3"/>

                    <!-- Bill Meta -->
                    <Grid Margin="0,0,0,5">
                        <TextBlock x:Name="TxtReceiptNo" Text="INV: INV-20260729-0001" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtReceiptDate" Text="Date: 29/07/2026 10:15" FontSize="11" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <TextBlock x:Name="TxtCashier" Text="Cashier: Admin" FontSize="11"/>
                        <TextBlock x:Name="TxtPaymentType" Text="Pay: CASH" FontSize="11" HorizontalAlignment="Right" FontWeight="Bold"/>
                    </Grid>
                    <TextBlock x:Name="TxtCustomer" Text="Customer: Walk-in Guest" FontSize="11" Margin="0,0,0,5"/>

                    <TextBlock Text="----------------------------------------" HorizontalAlignment="Center" Margin="0,2"/>

                    <!-- Items Header -->
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="75"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ITEM" FontWeight="Bold" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="QTY" FontWeight="Bold" FontSize="11" TextAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="PRICE" FontWeight="Bold" FontSize="11" TextAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="TOTAL" FontWeight="Bold" FontSize="11" TextAlignment="Right"/>
                    </Grid>
                    <TextBlock Text="----------------------------------------" HorizontalAlignment="Center" Margin="0,2"/>

                    <!-- Items List -->
                    <ItemsControl x:Name="ItemsReceiptList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="75"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontSize="11" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontSize="11" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat=N0}" FontSize="11" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{Binding TotalPrice, StringFormat=N0}" FontSize="11" TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="----------------------------------------" HorizontalAlignment="Center" Margin="0,5"/>

                    <!-- Totals -->
                    <Grid Margin="0,2">
                        <TextBlock Text="SUBTOTAL:" FontSize="11"/>
                        <TextBlock x:Name="TxtSubTotal" Text="LKR 0" FontSize="11" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="DISCOUNT:" FontSize="11"/>
                        <TextBlock x:Name="TxtDiscount" Text="LKR 0" FontSize="11" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock Text="----------------------------------------" HorizontalAlignment="Center" Margin="0,2"/>
                    <Grid Margin="0,4">
                        <TextBlock Text="NET TOTAL:" FontWeight="Bold" FontSize="14"/>
                        <TextBlock x:Name="TxtGrandTotal" Text="LKR 0" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="CASH TENDERED:" FontSize="11"/>
                        <TextBlock x:Name="TxtCashTendered" Text="LKR 0" FontSize="11" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="CHANGE DUE:" FontWeight="Bold" FontSize="12"/>
                        <TextBlock x:Name="TxtChangeDue" Text="LKR 0" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBlock Text="========================================" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                    <TextBlock Text="Thank You! Please Come Again." FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="*** SOFTWARE BY ENTERPRISE POS ***" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Receipt Action Buttons -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="🖨️ Print Receipt" Click="BtnPrint_Click" Background="#22C55E" Foreground="#0F172A" Height="40" Margin="0,0,5,0"/>
            <Button Grid.Column="1" Content="Close" Click="BtnClose_Click" Background="#334155" Foreground="White" Height="40" Margin="5,0,0,0"/>
        </Grid>
    </Grid>
</Window>
