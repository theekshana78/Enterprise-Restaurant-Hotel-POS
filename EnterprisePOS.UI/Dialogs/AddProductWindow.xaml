<Window x:Class="EnterprisePOS.UI.Dialogs.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin - Add / Edit Product Item" Height="520" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0F172A">
    <Grid Margin="20">
        <Border Background="#1E293B" CornerRadius="10" Padding="20" BorderBrush="#334155" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtHeader" Text="📦 Add New Product / Menu Item" Foreground="#38BDF8" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Product Name *" Foreground="#F8FAFC" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtName" Text="" FontSize="14" Padding="6" Background="#0F172A" Foreground="#F8FAFC"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Barcode *" Foreground="#F8FAFC" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtBarcode" Text="" FontSize="14" Padding="6" Background="#0F172A" Foreground="#F8FAFC"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Category *" Foreground="#F8FAFC" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbCategory" FontSize="14" Padding="6" Background="#0F172A" Foreground="#F8FAFC">
                            <ComboBoxItem Content="Food" IsSelected="True"/>
                            <ComboBoxItem Content="Beverages"/>
                            <ComboBoxItem Content="Snacks"/>
                            <ComboBoxItem Content="Consumables"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Unit" Foreground="#F8FAFC" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtUnit" Text="Pcs" FontSize="14" Padding="6" Background="#0F172A" Foreground="#F8FAFC"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Cost Price (LKR)" Foreground="#F8FAFC" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtCostPrice" Text="500" FontSize="14" Padding="6" Background="#0F172A" Foreground="#F8FAFC"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Selling Price (LKR) *" Foreground="#F8FAFC" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtSellingPrice" Text="950" FontSize="14" Padding="6" Background="#0F172A" Foreground="#F8FAFC"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Initial Stock Qty" Foreground="#F8FAFC" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtStock" Text="50" FontSize="14" Padding="6" Background="#0F172A" Foreground="#F8FAFC"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Min Stock Alert" Foreground="#F8FAFC" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtMinStock" Text="10" FontSize="14" Padding="6" Background="#0F172A" Foreground="#F8FAFC"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="ChkIsKitchen" Content="Send to Kitchen KOT Printer (e.g. Rice/Kottu)" Foreground="#38BDF8" FontWeight="Bold" Margin="0,0,0,20"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="💾 Save Product" Click="BtnSave_Click" Background="#22C55E" Foreground="#0F172A" Height="40" Margin="0,0,5,0"/>
                    <Button Grid.Column="1" Content="Cancel" Click="BtnCancel_Click" Background="#334155" Foreground="White" Height="40" Margin="5,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
