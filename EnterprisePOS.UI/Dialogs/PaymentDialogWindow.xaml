<Window x:Class="EnterprisePOS.UI.Dialogs.PaymentDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cash Register Settlement &amp; Change Calculator" Height="580" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0F172A">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Bill Amount Summary -->
            <RowDefinition Height="*"/>    <!-- Tender Numpad & Quick Cash -->
            <RowDefinition Height="Auto"/> <!-- Confirm / Cancel -->
        </Grid.RowDefinitions>

        <!-- Bill Amount Summary -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="10" Padding="15" Margin="0,0,0,15" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="TOTAL DUE:" Foreground="#94A3B8" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtTotalDue" Text="LKR 0" Foreground="#F8FAFC" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="CHANGE DUE BACK:" Foreground="#94A3B8" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtChangeDue" Text="LKR 0" Foreground="#22C55E" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Numpad & Quick Cash -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/> <!-- Numpad -->
                <ColumnDefinition Width="2*"/> <!-- Quick Cash Buttons -->
            </Grid.ColumnDefinitions>

            <!-- Touch Numpad -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="10" Padding="12" Margin="0,0,10,0" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Amount Input -->
                        <RowDefinition Height="*"/>    <!-- Keys -->
                    </Grid.RowDefinitions>
                    <TextBox x:Name="TxtCashTendered" Grid.Row="0" FontSize="22" FontWeight="Bold" TextAlignment="Right" Background="#0F172A" Foreground="#38BDF8" Padding="8" Margin="0,0,0,10" TextChanged="TxtCashTendered_TextChanged"/>
                    <UniformGrid Grid.Row="1" Columns="3">
                        <Button Content="7" Click="Numpad_Click" Background="#334155" Foreground="White" FontSize="18"/>
                        <Button Content="8" Click="Numpad_Click" Background="#334155" Foreground="White" FontSize="18"/>
                        <Button Content="9" Click="Numpad_Click" Background="#334155" Foreground="White" FontSize="18"/>
                        <Button Content="4" Click="Numpad_Click" Background="#334155" Foreground="White" FontSize="18"/>
                        <Button Content="5" Click="Numpad_Click" Background="#334155" Foreground="White" FontSize="18"/>
                        <Button Content="6" Click="Numpad_Click" Background="#334155" Foreground="White" FontSize="18"/>
                        <Button Content="1" Click="Numpad_Click" Background="#334155" Foreground="White" FontSize="18"/>
                        <Button Content="2" Click="Numpad_Click" Background="#334155" Foreground="White" FontSize="18"/>
                        <Button Content="3" Click="Numpad_Click" Background="#334155" Foreground="White" FontSize="18"/>
                        <Button Content="0" Click="Numpad_Click" Background="#334155" Foreground="White" FontSize="18"/>
                        <Button Content="00" Click="Numpad_Click" Background="#334155" Foreground="White" FontSize="18"/>
                        <Button Content="⌫" Click="BtnBackspace_Click" Background="#EF4444" Foreground="White" FontSize="18"/>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Quick Cash Tender Buttons -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="Quick Tender:" Foreground="#94A3B8" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                <Button Content="Exact Cash" Click="BtnQuickCash_Click" Tag="Exact" Background="#38BDF8" Foreground="#0F172A" FontSize="14" Height="42" Margin="0,0,0,6"/>
                <Button Content="Rs. 500" Click="BtnQuickCash_Click" Tag="500" Background="#334155" Foreground="White" FontSize="14" Height="42" Margin="0,0,0,6"/>
                <Button Content="Rs. 1,000" Click="BtnQuickCash_Click" Tag="1000" Background="#334155" Foreground="White" FontSize="14" Height="42" Margin="0,0,0,6"/>
                <Button Content="Rs. 2,000" Click="BtnQuickCash_Click" Tag="2000" Background="#334155" Foreground="White" FontSize="14" Height="42" Margin="0,0,0,6"/>
                <Button Content="Rs. 5,000" Click="BtnQuickCash_Click" Tag="5000" Background="#334155" Foreground="White" FontSize="14" Height="42"/>
            </StackPanel>
        </Grid>

        <!-- Bottom Action Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="✔ Complete Sale &amp; Print" Click="BtnConfirm_Click" Background="#22C55E" Foreground="#0F172A" FontSize="16" Height="45" Margin="0,0,5,0"/>
            <Button Grid.Column="1" Content="Cancel" Click="BtnCancel_Click" Background="#334155" Foreground="White" FontSize="16" Height="45" Margin="5,0,0,0"/>
        </Grid>
    </Grid>
</Window>
