<Window x:Class="EnterprisePOS.UI.Dialogs.CheckInDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotel Guest Check-In &amp; Registration" Height="480" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0F172A">
    <Grid Margin="20">
        <Border Background="#1E293B" CornerRadius="10" Padding="20" BorderBrush="#334155" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtRoomHeader" Text="🔑 Check-In: Room 01 (Double Room)" Foreground="#38BDF8" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                <TextBlock Text="Guest Full Name *" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtGuestName" Text="Mr. Kasun Perera" FontSize="14" Padding="6" Background="#0F172A" Foreground="#F8FAFC" Margin="0,0,0,12"/>

                <TextBlock Text="Phone / Mobile Number *" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtGuestPhone" Text="077 123 4567" FontSize="14" Padding="6" Background="#0F172A" Foreground="#F8FAFC" Margin="0,0,0,12"/>

                <TextBlock Text="NIC / Passport Number" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtGuestNIC" Text="199214502840" FontSize="14" Padding="6" Background="#0F172A" Foreground="#F8FAFC" Margin="0,0,0,20"/>

                <!-- Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="🔑 Complete Check-In" Click="BtnConfirm_Click" Background="#22C55E" Foreground="#0F172A" Height="40" Margin="0,0,5,0"/>
                    <Button Grid.Column="1" Content="Cancel" Click="BtnCancel_Click" Background="#334155" Foreground="White" Height="40" Margin="5,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
