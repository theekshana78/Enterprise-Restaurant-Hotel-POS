<Window x:Class="EnterprisePOS.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enterprise POS &amp; Hotel Management System v1.0" Height="768" Width="1280"
        WindowStartupLocation="CenterScreen" Background="#0F172A" KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar & Hotkeys -->
            <RowDefinition Height="*"/>    <!-- Main View Content -->
            <RowDefinition Height="Auto"/> <!-- Footer Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Navigation & Hotkey Bar -->
        <Border Grid.Row="0" Background="#1E293B" Padding="12,10" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡ ENTERPRISE POS" Foreground="#38BDF8" FontSize="20" FontWeight="Bold" Margin="0,0,20,0"/>
                </StackPanel>

                <!-- Hotkey Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnNavPOS" Content="[F1] Cashier POS" Click="BtnNavPOS_Click" Background="#0284C7" Foreground="White" Margin="3,0" Padding="10,6"/>
                    <Button x:Name="BtnNavTables" Content="[F2] Tables" Click="BtnNavTables_Click" Background="#334155" Foreground="White" Margin="3,0" Padding="10,6"/>
                    <Button x:Name="BtnNavRooms" Content="[F3] Hotel Rooms" Click="BtnNavRooms_Click" Background="#334155" Foreground="White" Margin="3,0" Padding="10,6"/>
                    <Button x:Name="BtnNavKDS" Content="[F4] Kitchen KDS" Click="BtnNavKDS_Click" Background="#334155" Foreground="White" Margin="3,0" Padding="10,6"/>
                    <Button x:Name="BtnNavStock" Content="[F5] Inventory" Click="BtnNavStock_Click" Background="#334155" Foreground="White" Margin="3,0" Padding="10,6"/>
                    <Button x:Name="BtnNavAI" Content="[F6] AI Dashboard" Click="BtnNavAI_Click" Background="#334155" Foreground="White" Margin="3,0" Padding="10,6"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👤 User: " Foreground="#94A3B8" FontSize="13"/>
                    <TextBlock x:Name="TxtUserStatus" Text="Head Cashier (Cashier)" Foreground="#22C55E" FontWeight="Bold" FontSize="13" Margin="0,0,10,0"/>
                    <Button Content="🔒 Logout" Click="BtnLogout_Click" Background="#EF4444" Foreground="White" Padding="8,4" FontSize="11" Margin="5,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dynamic Main Content View -->
        <ContentControl x:Name="MainContentArea" Grid.Row="1"/>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#0F172A" Padding="10,5" BorderBrush="#334155" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock Text="Local DB: pos_enterprise.db (SQLite Embedded)" Foreground="#64748B" FontSize="11"/>
                <TextBlock Text="Keyboard Shortcuts: [F1] POS | [F2] Rooms | [F3] Stock | [F4] AI | [F5] Cash Pay | [F6] Card Pay | [F7] Room Tab | [F8] Print KOT" Foreground="#38BDF8" FontSize="11" HorizontalAlignment="Right" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
