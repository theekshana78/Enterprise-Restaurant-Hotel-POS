<UserControl x:Class="EnterprisePOS.UI.Views.RoomManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Legend -->
            <RowDefinition Height="*"/>    <!-- Room Cards Grid -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="🏨 Hotel &amp; Room Management System" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text="Manage Room Check-ins, Food/Beverage Accrued Bills, and Checkout Invoices" Foreground="#94A3B8" FontSize="13"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="#22C55E" CornerRadius="4" Padding="8,4" Margin="4,0"><TextBlock Text="Available" Foreground="#0F172A" FontWeight="Bold" FontSize="12"/></Border>
                <Border Background="#EF4444" CornerRadius="4" Padding="8,4" Margin="4,0"><TextBlock Text="Occupied" Foreground="White" FontWeight="Bold" FontSize="12"/></Border>
                <Border Background="#F59E0B" CornerRadius="4" Padding="8,4" Margin="4,0"><TextBlock Text="Cleaning" Foreground="#0F172A" FontWeight="Bold" FontSize="12"/></Border>
            </StackPanel>
        </DockPanel>

        <!-- Rooms Grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ItemsRoomGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1E293B" CornerRadius="12" Margin="10" Padding="15" BorderBrush="#334155" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding RoomNumber}" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                                    <Border HorizontalAlignment="Right" CornerRadius="6" Padding="10,4" Background="#334155">
                                        <TextBlock Text="{Binding Status}" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    </Border>
                                </DockPanel>

                                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding RoomType, StringFormat='Type: {0}'}" Foreground="#94A3B8" FontSize="14"/>
                                    <TextBlock Text="{Binding RatePerNight, StringFormat='Rate: LKR {0:N0} / Night'}" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>

                                <Border Grid.Row="2" Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,5,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CurrentGuestName, StringFormat='Guest: {0}'}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="{Binding PendingAccruedBill, StringFormat='Accrued Food/Drinks Bill: LKR {0:N0}'}" Foreground="#F59E0B" FontWeight="Bold" FontSize="13" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="🔑 Check-In" Tag="{Binding}" Click="BtnCheckIn_Click" Background="#22C55E" Foreground="#0F172A" Margin="0,0,8,0"/>
                                    <Button Content="🧾 Check-Out &amp; Pay" Tag="{Binding}" Click="BtnCheckOut_Click" Background="#38BDF8" Foreground="#0F172A"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
