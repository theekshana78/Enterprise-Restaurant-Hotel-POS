<UserControl x:Class="EnterprisePOS.UI.Views.CashierPOSView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/> <!-- Product Catalog & Search -->
            <ColumnDefinition Width="2*"/> <!-- Active Cart & Checkout -->
        </Grid.ColumnDefinitions>

        <!-- Left Column: Product Selection Grid -->
        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Barcode & Search -->
                <RowDefinition Height="Auto"/> <!-- Category Tabs -->
                <RowDefinition Height="*"/>    <!-- Product Cards -->
            </Grid.RowDefinitions>

            <!-- Search & Barcode -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,15" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍 Barcode / Search:" Foreground="#94A3B8" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtBarcode" Grid.Column="1" KeyUp="TxtBarcode_KeyUp" FontSize="16" Padding="6" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#38BDF8"/>
                    <Button Grid.Column="2" Content="Clear" Click="BtnClearSearch_Click" Background="#334155" Foreground="#F8FAFC" Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <!-- Category Filter Tabs -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                <Button x:Name="BtnCatAll" Content="All Items" Click="BtnCategory_Click" Tag="All" Background="#38BDF8" Foreground="#0F172A" Margin="0,0,8,0"/>
                <Button x:Name="BtnCatFood" Content="🍱 Food (Rice/Kottu)" Click="BtnCategory_Click" Tag="Food" Background="#334155" Foreground="#F8FAFC" Margin="0,0,8,0"/>
                <Button x:Name="BtnCatBev" Content="🥤 Beverages (RedBull/Beer/Water)" Click="BtnCategory_Click" Tag="Beverages" Background="#334155" Foreground="#F8FAFC" Margin="0,0,8,0"/>
                <Button x:Name="BtnCatSnack" Content="🥜 Snacks" Click="BtnCategory_Click" Tag="Snacks" Background="#334155" Foreground="#F8FAFC"/>
            </StackPanel>

            <!-- Product Touch Grid -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsProductGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E293B" CornerRadius="10" Margin="6" Padding="12" BorderBrush="#334155" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="Bold" Foreground="#F8FAFC" FontSize="15" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Category}" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,6"/>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="LKR " Foreground="#38BDF8" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="{Binding SellingPrice, StringFormat=N0}" Foreground="#38BDF8" FontWeight="Bold" FontSize="16"/>
                                    </StackPanel>
                                    <Button Grid.Row="3" Content="+ Add to Cart" Tag="{Binding}" Click="BtnAddToCart_Click" Background="#0284C7" Foreground="#F8FAFC"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Right Column: Cart & Payment -->
        <Border Grid.Column="1" Background="#1E293B" CornerRadius="10" Padding="15" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title -->
                    <RowDefinition Height="*"/>    <!-- Cart DataGrid -->
                    <RowDefinition Height="Auto"/> <!-- Subtotal & Discount -->
                    <RowDefinition Height="Auto"/> <!-- Payment Buttons -->
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="🛒 Active Cart" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <Button Content="Clear Cart" Click="BtnClearCart_Click" Background="#EF4444" Foreground="White" HorizontalAlignment="Right" Padding="8,4"/>
                </DockPanel>

                <!-- DataGrid Cart -->
                <DataGrid x:Name="DgCart" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" Background="#0F172A" Foreground="#F8FAFC" RowBackground="#1E293B" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=N0}" Width="Auto"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="Auto"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice, StringFormat=N0}" Width="Auto"/>
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="❌" Tag="{Binding}" Click="BtnRemoveCartItem_Click" Background="Transparent" Foreground="#EF4444" Padding="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Total & Summary -->
                <StackPanel Grid.Row="2" Margin="0,15,0,15">
                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="SubTotal:" Foreground="#94A3B8" FontSize="14"/>
                        <TextBlock x:Name="TxtSubTotal" Text="LKR 0" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="Discount (LKR):" Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtDiscount" Text="0" Width="100" HorizontalAlignment="Right" TextChanged="TxtDiscount_TextChanged" TextAlignment="Right"/>
                    </Grid>
                    <Separator Background="#334155" Margin="0,5"/>
                    <Grid Margin="0,5,0,0">
                        <TextBlock Text="GRAND TOTAL:" Foreground="#38BDF8" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtGrandTotal" Text="LKR 0" Foreground="#22C55E" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>

                <!-- Action / Payment Buttons -->
                <StackPanel Grid.Row="3">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="💵 Cash Pay (F5)" Click="BtnPayCash_Click" Background="#22C55E" Foreground="#0F172A" FontSize="15" Height="45"/>
                        <Button Grid.Column="1" Content="💳 Card Pay (F6)" Click="BtnPayCard_Click" Background="#38BDF8" Foreground="#0F172A" FontSize="15" Height="45"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="🏨 Add to Room (F7)" Click="BtnPayRoomCharge_Click" Background="#F59E0B" Foreground="#0F172A" FontSize="13" Height="40"/>
                        <Button Grid.Column="1" Content="🍳 Print KOT (F8)" Click="BtnPrintKOT_Click" Background="#A855F7" Foreground="White" FontSize="13" Height="40"/>
                    </Grid>
                    <Button Content="📋 Print Pre-Bill / Table Slip" Click="BtnPrintPreBill_Click" Background="#64748B" Foreground="White" FontSize="14" Height="38"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
