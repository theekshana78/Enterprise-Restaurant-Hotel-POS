<UserControl x:Class="EnterprisePOS.UI.Views.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">
    <Grid Margin="15">
        <TabControl Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC">
            <!-- TAB 1: EXECUTIVE FINANCIAL DASHBOARD -->
            <TabItem Header="📊 Financial Dashboard &amp; Z-Report" FontSize="14" FontWeight="Bold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Metrics Cards -->
                        <RowDefinition Height="*"/>    <!-- Sales Transactions -->
                    </Grid.RowDefinitions>

                    <!-- Metrics Cards -->
                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,15">
                        <Border Background="#0F172A" CornerRadius="10" Padding="15" Margin="5" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Total Revenue" Foreground="#94A3B8" FontSize="13"/>
                                <TextBlock x:Name="TxtTotalRevenue" Text="LKR 0" Foreground="#22C55E" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0F172A" CornerRadius="10" Padding="15" Margin="5" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Total Invoices Issued" Foreground="#94A3B8" FontSize="13"/>
                                <TextBlock x:Name="TxtTotalInvoices" Text="0" Foreground="#38BDF8" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0F172A" CornerRadius="10" Padding="15" Margin="5" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Occupied Hotel Rooms" Foreground="#94A3B8" FontSize="13"/>
                                <TextBlock x:Name="TxtActiveRooms" Text="0 / 4" Foreground="#F59E0B" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0F172A" CornerRadius="10" Padding="15" Margin="5" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Low Stock Warnings" Foreground="#94A3B8" FontSize="13"/>
                                <TextBlock x:Name="TxtLowStockCount" Text="0 Items" Foreground="#EF4444" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Recent Sales Table -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="10" Padding="15" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="🧾 Recent Invoices &amp; Sales Audit Log" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                <Button Content="📑 Close Shift &amp; Print Z-Report" Click="BtnZReport_Click" Background="#22C55E" Foreground="#0F172A" HorizontalAlignment="Right" Padding="10,5"/>
                            </DockPanel>
                            <DataGrid x:Name="DgInvoices" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" Background="#1E293B" Foreground="#F8FAFC" RowBackground="#0F172A" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Invoice No" Binding="{Binding InvoiceNo}" Width="Auto"/>
                                    <DataGridTextColumn Header="Date / Time" Binding="{Binding InvoiceDate, StringFormat=dd/MM/yyyy HH:mm}" Width="Auto"/>
                                    <DataGridTextColumn Header="Payment" Binding="{Binding PaymentMethod}" Width="Auto"/>
                                    <DataGridTextColumn Header="Cashier" Binding="{Binding CashierName}" Width="Auto"/>
                                    <DataGridTextColumn Header="SubTotal" Binding="{Binding SubTotal, StringFormat=N0}" Width="Auto"/>
                                    <DataGridTextColumn Header="Discount" Binding="{Binding Discount, StringFormat=N0}" Width="Auto"/>
                                    <DataGridTextColumn Header="Net Total (LKR)" Binding="{Binding GrandTotal, StringFormat=N0}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: MASTER PRODUCT & MENU CONTROL -->
            <TabItem Header="📦 Products &amp; Menu Master" FontSize="14" FontWeight="Bold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Menu Items &amp; Product Master Catalog" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        <Button Content="➕ Add New Product" Click="BtnAddProduct_Click" Background="#22C55E" Foreground="#0F172A" HorizontalAlignment="Right" Padding="12,6"/>
                    </DockPanel>
                    <DataGrid x:Name="DgProducts" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" Background="#0F172A" Foreground="#F8FAFC" RowBackground="#1E293B" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                            <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="Auto"/>
                            <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="Auto"/>
                            <DataGridTextColumn Header="Cost (LKR)" Binding="{Binding CostPrice, StringFormat=N0}" Width="Auto"/>
                            <DataGridTextColumn Header="Selling (LKR)" Binding="{Binding SellingPrice, StringFormat=N0}" Width="Auto"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding CurrentStock}" Width="Auto"/>
                            <DataGridTextColumn Header="Min Alert" Binding="{Binding MinStockLevel}" Width="Auto"/>
                            <DataGridTextColumn Header="KOT Item?" Binding="{Binding IsKitchenItem}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 3: STAFF & USER MANAGEMENT -->
            <TabItem Header="👥 Staff &amp; Cashier Accounts" FontSize="14" FontWeight="Bold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="System Users &amp; Cashier Staff Accounts" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid x:Name="DgUsers" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" Background="#0F172A" Foreground="#F8FAFC" RowBackground="#1E293B" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="User ID" Binding="{Binding Id}" Width="Auto"/>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="Auto"/>
                            <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="Auto"/>
                            <DataGridTextColumn Header="Is Active?" Binding="{Binding IsActive}" Width="Auto"/>
                            <DataGridTextColumn Header="Created Date" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 4: AI FORECASTING & SECURITY AUDITS -->
            <TabItem Header="🤖 AI Forecast &amp; Security Audits" FontSize="14" FontWeight="Bold">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#0F172A" CornerRadius="10" Padding="15" Margin="0,0,10,0" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="🤖 AI Demand Forecasting &amp; Smart Reorders" FontSize="16" FontWeight="Bold" Foreground="#38BDF8"/>
                                <TextBlock Text="Predicts weekly stock requirements based on ~100 daily customers" Foreground="#94A3B8" FontSize="12"/>
                            </StackPanel>
                            <DataGrid x:Name="DgAIForecast" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" Background="#1E293B" Foreground="#F8FAFC" RowBackground="#0F172A" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                                    <DataGridTextColumn Header="Stock" Binding="{Binding CurrentStock}" Width="Auto"/>
                                    <DataGridTextColumn Header="Est. Demand" Binding="{Binding PredictedWeeklyDemand}" Width="Auto"/>
                                    <DataGridTextColumn Header="Rec. Reorder" Binding="{Binding RecommendedOrderQty}" Width="Auto"/>
                                    <DataGridTextColumn Header="Risk Level" Binding="{Binding RiskLevel}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="#0F172A" CornerRadius="10" Padding="15" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="🛡️ AI Fraud &amp; Security Audit Log" FontSize="16" FontWeight="Bold" Foreground="#EF4444"/>
                                <TextBlock Text="Flags unauthorized cashier discounts and zero sales" Foreground="#94A3B8" FontSize="12"/>
                            </StackPanel>
                            <DataGrid x:Name="DgFraudAlerts" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" Background="#1E293B" Foreground="#F8FAFC" RowBackground="#0F172A" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding AlertTime, StringFormat=HH:mm}" Width="Auto"/>
                                    <DataGridTextColumn Header="Factor" Binding="{Binding RiskFactor}" Width="Auto"/>
                                    <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
