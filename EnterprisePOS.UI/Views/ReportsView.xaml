<UserControl x:Class="EnterprisePOS.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Reports Grid & Details -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" Padding="16" CornerRadius="12" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="📊 ENTERPRISE REPORTS &amp; ANALYTICS HUB" Foreground="#F8FAFC" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Financial Sales Reports • Inventory Valuation • Waiter Performance • Room Service Logs" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="📥 Export PDF / Excel" Click="BtnExport_Click" Background="#22C55E" Foreground="#0F172A" Padding="14,8" FontWeight="Bold"/>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Report Type Selection Menu -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="10" Padding="12" Margin="0,0,16,0" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="REPORT CATEGORIES" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Button Content="📈 Daily Sales Report" Click="BtnReportDaily_Click" Background="#0284C7" Foreground="White" Margin="0,0,0,6" Height="36"/>
                    <Button Content="📅 Monthly Sales Summary" Click="BtnReportMonthly_Click" Background="#334155" Foreground="White" Margin="0,0,0,6" Height="36"/>
                    <Button Content="🔥 Best Selling Items" Click="BtnReportBestSellers_Click" Background="#334155" Foreground="White" Margin="0,0,0,6" Height="36"/>
                    <Button Content="👨💼 Waiter &amp; Cashier Sales" Click="BtnReportStaff_Click" Background="#334155" Foreground="White" Margin="0,0,0,6" Height="36"/>
                    <Button Content="📦 Stock &amp; Purchase Reports" Click="BtnReportInventory_Click" Background="#334155" Foreground="White" Margin="0,0,0,6" Height="36"/>
                    <Button Content="🛏️ Room Service Audit Log" Click="BtnReportRoomService_Click" Background="#334155" Foreground="White" Margin="0,0,0,6" Height="36"/>
                    <Button Content="💰 Gross Profit Analysis" Click="BtnReportProfit_Click" Background="#334155" Foreground="White" Height="36"/>
                </StackPanel>
            </Border>

            <!-- Data Table Display -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="10" Padding="16" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="TxtReportTitle" Text="Daily Sales Report" Foreground="#38BDF8" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtTotalSummary" Text="Total Sales: LKR 0" Foreground="#22C55E" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <DataGrid x:Name="DgReports" Grid.Row="1" AutoGenerateColumns="True" Background="#0F172A" Foreground="#F8FAFC" RowBackground="#1E293B" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
