<UserControl x:Class="EnterprisePOS.UI.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Controls -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="📦 Product Stock &amp; Consumables Management" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text="Track menu items, bottled drinks, toilet paper, bill paper rolls, and reorder levels" Foreground="#94A3B8" FontSize="13"/>
            </StackPanel>
            <Button x:Name="BtnRefillStock" Content="➕ Refill Stock" Click="BtnRefillStock_Click" Background="#22C55E" Foreground="#0F172A" HorizontalAlignment="Right" Padding="12,6"/>
        </DockPanel>

        <!-- Inventory DataGrid -->
        <DataGrid x:Name="DgInventory" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" Background="#1E293B" Foreground="#F8FAFC" RowBackground="#0F172A" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="Auto"/>
                <DataGridTextColumn Header="Product / Item Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="Auto"/>
                <DataGridTextColumn Header="Type" Binding="{Binding ItemType}" Width="Auto"/>
                <DataGridTextColumn Header="Cost (LKR)" Binding="{Binding CostPrice, StringFormat=N0}" Width="Auto"/>
                <DataGridTextColumn Header="Sell (LKR)" Binding="{Binding SellingPrice, StringFormat=N0}" Width="Auto"/>
                <DataGridTextColumn Header="Current Stock" Binding="{Binding CurrentStock}" Width="Auto"/>
                <DataGridTextColumn Header="Min Alert" Binding="{Binding MinStockLevel}" Width="Auto"/>
                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
