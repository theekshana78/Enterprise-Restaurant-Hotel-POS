<Window x:Class="EnterprisePOS.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enterprise POS - Secure Login" Height="640" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0F172A" KeyDown="Window_KeyDown">
    <Grid Margin="16">
        <Border Background="#1E293B" CornerRadius="16" Padding="24" BorderBrush="#334155" BorderThickness="1.5">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Center">
                    <!-- App Branding -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Border Width="48" Height="48" CornerRadius="24" Background="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock Text="🏨" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="ABC HOTEL POS SYSTEM" Foreground="#F8FAFC" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Enterprise POS &amp; Hotel Management" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Branch Selection -->
                    <TextBlock Text="Branch / Terminal Location" Foreground="#F8FAFC" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbBranch" DisplayMemberPath="BranchName" SelectedValuePath="Id" FontSize="14" Padding="6" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#38BDF8" Margin="0,0,0,10"/>

                    <!-- Username Input -->
                    <TextBlock Text="Username" Foreground="#F8FAFC" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtUsername" Text="" FontSize="14" Padding="6" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#38BDF8" Margin="0,0,0,10"/>

                    <!-- Password Input with Eye Toggle -->
                    <TextBlock Text="Password" Foreground="#F8FAFC" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,10">
                        <PasswordBox x:Name="TxtPassword" Password="" FontSize="14" Padding="6,6,40,6" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#38BDF8"/>
                        <TextBox x:Name="TxtVisiblePassword" Text="" FontSize="14" Padding="6,6,40,6" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#38BDF8" Visibility="Collapsed"/>
                        <Button x:Name="BtnTogglePassword" Content="👁️" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Background="Transparent" Foreground="#38BDF8" Click="BtnTogglePassword_Click" ToolTip="Show/Hide Password"/>
                    </Grid>

                    <!-- Remember Me & Forgot Password -->
                    <Grid Margin="0,0,0,10">
                        <CheckBox x:Name="ChkRememberMe" Content="Remember Me" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Forgot Password?" Foreground="#38BDF8" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" MouseDown="TxtForgotPassword_MouseDown"/>
                    </Grid>

                    <!-- Error Message Label -->
                    <Border x:Name="BorderError" Background="#451A1A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock x:Name="LblError" Foreground="#FCA5A5" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="🔓 Login" Click="BtnLogin_Click" Background="#22C55E" Foreground="#0F172A" FontSize="15" Height="45" FontWeight="Bold" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="❌ Exit" Click="BtnExit_Click" Background="#EF4444" Foreground="#FFFFFF" FontSize="14" Height="45" Width="95" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
